# OpenWebUI v0.6.5 audio env names verified against backend/open_webui/config.py.
# Select explicit local audio providers; chat/LLM provider remains separate.
# Shared Docker network: http://gateway:8080/v1
# Separate Docker container accessing host: http://host.docker.internal:8080/v1
# NOTE localhost-only Voxi port is not reachable via host.docker.internal on every host.
# Prefer an explicitly shared Docker network; do not publish workers or widen gateway bind.
AUDIO_STT_ENGINE=openai
AUDIO_STT_OPENAI_API_BASE_URL=http://gateway:8080/v1
AUDIO_STT_OPENAI_API_KEY=
AUDIO_STT_MODEL=whisper-1
AUDIO_TTS_ENGINE=openai
AUDIO_TTS_OPENAI_API_BASE_URL=http://gateway:8080/v1
AUDIO_TTS_OPENAI_API_KEY=
AUDIO_TTS_MODEL=ema-lightning
AUDIO_TTS_VOICE=ema-tr
# Existing stored admin settings override env unless disabled explicitly.
# ENABLE_PERSISTENT_CONFIG=False
