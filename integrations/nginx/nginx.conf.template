# -----------------------------------------------------------------------------
# Voxi TLS reverse proxy — RENDERED TEMPLATE.
#
# This file is NOT nginx config as-is: /etc/nginx/voxi-entrypoint.sh substitutes
# exactly three variables (${VOXI_INJECT_ON}, ${VOXI_INJECT_AUTH},
# ${VOXI_RUNTIME_JSON}) via `sed` and writes the result to
# /etc/nginx/conf.d/default.conf (mode 0600, root-only, because in keyless mode
# it embeds a bearer). The conf.d file is included at `http{}` level by the stock
# nginx.conf, so the `map` and `log_format` blocks below are valid here.
#
# Design goals (see docs/deployment.md · "Turnkey local identity"):
#   * Keyless is SOUND, not merely loopback-bound. Any other page in the same
#     browser could dial http://127.0.0.1:8443 and, with DNS rebinding, read the
#     answer — so we additionally fail closed on a foreign Host and on cross-site
#     requests BEFORE injecting any credential or touching the upstream.
#   * No CORS is ever advertised: same-origin is the only supported WebUI origin.
#   * The bearer is never logged: `voxi_safe` records `$uri` only (no query, no
#     headers) and http-level error_log is pinned to `warn` (never `debug`, which
#     would dump request headers).
# -----------------------------------------------------------------------------

# Correct Connection header for both plain HTTP and WebSocket upgrade requests.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Access log format that NEVER records the query string or any header. Realtime
# clients authenticate via `?token=`; `$uri` is the normalised path only.
log_format voxi_safe '$remote_addr - $remote_user [$time_local] '
                     '"$request_method $uri $server_protocol" '
                     '$status $body_bytes_sent '
                     '"$http_referer" "$http_user_agent" "$http_x_forwarded_for"';

# http-level error_log pinned to `warn`: never `debug`/`info`, which would dump
# request headers (and therefore the bearer) to the error log.
error_log /var/log/nginx/error.log warn;

# --- Host allowlist (DNS-rebinding cut). `$host` strips the port; IPv6 keeps
# brackets, so both `[::1]` and the bare form are listed. ---
map $host $voxi_host_bad {
    default    1;
    localhost  0;
    127.0.0.1  0;
    ::1        0;
    "[::1]"    0;
}

# --- Cross-site signals. Only our own loopback origins are considered "same". ---
map $http_origin $voxi_origin_bad {
    default                                                    1;
    ""                                                         0;
    "~^https?://(localhost|127\.0\.0\.1|\[::1\])(:[0-9]+)?$"   0;
}
map $http_sec_fetch_site $voxi_secfetch_bad {
    default      0;
    cross-site   1;
}

# The three guards below activate ONLY in keyless inject mode (${VOXI_INJECT_ON}
# renders to 1; in LAN mode it renders to 0 so every combination falls to default
# = allow, i.e. a per-client-key request to any Host on the TLS listener passes).
map "${VOXI_INJECT_ON}$voxi_host_bad"     $voxi_host_deny   { default 0; "11" 1; }
map "${VOXI_INJECT_ON}$voxi_origin_bad"   $voxi_origin_deny { default 0; "11" 1; }
map "${VOXI_INJECT_ON}$voxi_secfetch_bad" $voxi_secfetch_deny { default 0; "11" 1; }
# Deny if EITHER cross-site signal tripped (only reachable when inject is on).
map "$voxi_origin_deny$voxi_secfetch_deny" $voxi_csrf_deny  { default 1; "00" 0; }

# Effective upstream Authorization: forward the client's bearer when present; if
# absent and injection is on, substitute the local WebUI key. In LAN mode
# ${VOXI_INJECT_AUTH} renders empty, so a request with no bearer reaches the
# gateway unauthenticated and is (correctly) rejected with 401.
map $http_authorization $voxi_effective_auth {
    default  $http_authorization;
    ''       "${VOXI_INJECT_AUTH}";
}

server {
    listen 8443 ssl;
    # HTTP/2 is intentionally OFF: nginx cannot proxy the WebSocket `Upgrade`
    # handshake over h2, so enabling it would hang /v1/tts/stream and
    # /v1/realtime/transcriptions for any browser that negotiates h2 via ALPN.
    server_name _;

    access_log /var/log/nginx/access.log voxi_safe;

    # TLS is mandatory on this listener (never a plaintext bearer). Entrypoint
    # refuses to start if the cert is absent, so LAN mode can't silently drop it.
    ssl_certificate     /etc/nginx/tls/voxi.crt;
    ssl_certificate_key /etc/nginx/tls/voxi.key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 10m;

    # STT file uploads: stay above VOXI_MAX_UPLOAD_BYTES with headroom.
    client_max_body_size 300m;

    # Streaming routes apply their own bounded backpressure; buffering defeats it.
    proxy_buffering         off;
    proxy_request_buffering off;

    # Fail closed on rebinding / cross-site BEFORE any injection or upstream hop.
    if ($voxi_host_deny = 1) { return 421; }
    if ($voxi_csrf_deny = 1) { return 403; }

    # Operator-facing runtime status (no secret, no auth). Body set by entrypoint.
    # Lets the WebUI show "yerel otomatik kimlik" vs "anahtar gerekli" without
    # touching the /v1 API contract.
    location = /ui/runtime.json {
        default_type application/json;
        add_header Cache-Control "no-store";
        return 200 '${VOXI_RUNTIME_JSON}';
    }

    # Voxi WebUI: served by the dedicated `webui` container (its own Docker
    # Desktop Logs tab). The proxy only terminates TLS + enforces identity, then
    # forwards /ui to the frontend over the internal `speech` network.
    location /ui/ {
        proxy_pass          http://webui:8080;
        proxy_http_version  1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = / {
        return 302 /ui/;
    }

    # Model assets served to the browser (Turkish punctuation ONNX + optional
    # browser model packs). `gzip off` is set at the webui location; ranged
    # reads must not be recompressed.
    location /models/ {
        proxy_pass http://webui:8080;
        proxy_set_header Host $host;
    }

    location / {
        proxy_pass          http://gateway:8080;
        proxy_http_version  1.1;

        # WebSocket handshake forwarding (ADR 0005 transports).
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Local keyless identity is added here (see $voxi_effective_auth). The
        # value never appears in an access_log line (voxi_safe) or error_log.
        proxy_set_header Authorization     $voxi_effective_auth;

        # Keep this ABOVE VOXI_WS_IDLE_TIMEOUT so the gateway, not the proxy,
        # reaps a silent socket.
        proxy_connect_timeout 15s;
        proxy_send_timeout    3600s;
        proxy_read_timeout    3600s;
    }
}
