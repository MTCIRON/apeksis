  "components": {
    "schemas": {
      "Body_transcription_v1_audio_transcriptions_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "model": {
            "type": "string",
            "title": "Model",
            "default": "whisper-1"
          },
          "language": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Language"
          },
          "prompt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Prompt"
          },
          "response_format": {
            "type": "string",
            "title": "Response Format",
            "default": "json"
          },
          "temperature": {
            "type": "number",
            "title": "Temperature",
            "default": 0
          },
          "word_timestamps": {
            "type": "boolean",
            "title": "Word Timestamps",
            "default": false
          },
          "timestamp_granularities": {
            "anyOf": [
              {
                "items": {
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "title": "Timestamp Granularities"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_transcription_v1_audio_transcriptions_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "SocketTicketMintRequest": {
        "properties": {
          "scope": {
            "type": "string",
            "enum": [
              "audio:write",
              "audio:read",
              "realtime:connect"
            ],
            "title": "Scope"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "scope"
        ],
        "title": "SocketTicketMintRequest",
        "description": "Body for POST /v1/auth/socket (F5 security).\n\nBrowser WebSocket clients cannot set an Authorization header, so they\npreviously sent the bearer in the URL via `?token=`. That leaks the long-\nlived key into any component that records the request line (packet capture,\nextensions, third-party log pipelines). This endpoint short-circuits the\nexposure: the caller authenticates with the normal Bearer header, receives\nan opaque single-use ticket bound to the requested scope, and dials the\nsocket with `?ticket=<value>`. The old `?token=` path is retained for\nbackwards compatibility; nothing in this contract breaks existing clients."
      },
      "SpeechRequest": {
        "properties": {
          "model": {
            "type": "string",
            "title": "Model",
            "default": "ema-lightning"
          },
          "input": {
            "type": "string",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Input"
          },
          "voice": {
            "type": "string",
            "title": "Voice",
            "default": "ema-tr"
          },
          "response_format": {
            "type": "string",
            "enum": [
              "wav",
              "pcm",
              "mp3"
            ],
            "title": "Response Format",
            "default": "mp3"
          },
          "speed": {
            "type": "number",
            "maximum": 4.0,
            "minimum": 0.25,
            "title": "Speed",
            "default": 1
          },
          "sample_rate": {
            "type": "integer",
            "enum": [
              8000,
              16000,
              24000,
              48000
            ],
            "title": "Sample Rate",
            "default": 24000
          },
          "seed": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Seed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "input"
        ],
        "title": "SpeechRequest"
      },
      "TurnInput": {
        "properties": {
          "transcript": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Transcript"
          },
          "language": {
            "type": "string",
            "title": "Language",
            "default": "tr-TR"
          },
          "context": {
            "additionalProperties": true,
            "type": "object",
            "title": "Context"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "transcript"
        ],
        "title": "TurnInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "VoxiApiKey": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "API key"
      }
    }
  }
}
