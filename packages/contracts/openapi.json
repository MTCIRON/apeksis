    "/v1/auth/socket": {
      "post": {
        "summary": "Mint Socket Ticket",
        "description": "F5: single-use, short-lived WebSocket handshake ticket.\n\nThe caller authenticates with the normal Bearer header and declares the\nscope of the socket they intend to open. The gateway issues an opaque\nticket bound to that principal + scope; the browser then dials the WS\nroute with `?ticket=<value>` instead of leaking its long-lived key in\nthe URL. Ticket lifetime is `VOXI_WS_TICKET_TTL` (default 30 s) and\nevery value is consumed on first successful handshake; replays of the\nsame ticket are rejected, expired tickets are reaped, and any probe\nerror collapses to a single 401 to avoid a liveness oracle.",
        "operationId": "mint_socket_ticket_v1_auth_socket_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SocketTicketMintRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Mint Socket Ticket V1 Auth Socket Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        },
        "security": [
          {
            "VoxiApiKey": []
          }
        ]
      }
    },
    "/v1/endpoints": {
      "get": {
        "summary": "Endpoints",
        "description": "Every route this gateway serves and the scope a key needs for it.\n\nPublic routes carry an empty `scopes` list. This is the honest answer to\n\"which key do I give an external client?\": it lists the agent (n8n)\nsession routes and the Voxi streaming sockets too, not only the\nOpenAI-compatible subset.",
        "operationId": "endpoints_v1_endpoints_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
