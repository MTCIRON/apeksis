# Copy to .env only to PIN your own values. A fresh clone needs no .env: the
# one-shot `secrets` service generates the worker key, the master key, the local
# WebUI key and the keyring on the first `docker compose up -d`. Anything set
# below wins over that generated material.
#
# Install command: the TLS/UI proxy is defined only in infra/compose.proxy.yaml,
# so a complete install is
#   docker compose -f compose.yaml -f infra/compose.proxy.yaml up -d --wait --wait-timeout 900
# A bare `docker compose up -d` starts the API WITHOUT the proxy and /ui/.
# Optional convenience: uncommenting the next line makes the bare command include
# the proxy as well, so you can drop the repeated -f flags. Explicit -f flags
# always override it. It is OFF by default on purpose: a hidden auto-loaded proxy
# would also make a mis-set VOXI_PROXY_BIND_IP able to fail the whole `up`.
# COMPOSE_FILE=compose.yaml:infra/compose.proxy.yaml
# Generate DIFFERENT keys: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Optional override; >=32 characters. No supplied secrets, cloud credentials, or admin password.
VOXI_API_KEY=
# Optional additional scoped/revocable keys. Store hashes, never plaintext keys here.
# VOXI_API_KEYS_JSON='[{"id":"stt-client","sha256":"<sha256-lowercase-hex>","scopes":["audio:write"]}]'
VOXI_API_KEYS_JSON=
# Optional smoke-only client secret when VOXI_API_KEY is empty and hashed keys are used.
# Requires audio:read and audio:write; defaults to VOXI_API_KEY when unset.
VOXI_SMOKE_API_KEY=
# Only needed if a pinned model repository is gated (all pinned repos are public
# today, so leave this empty). Read by the provision-* services at runtime;
# never baked into an image and never logged.
# HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
# Optional override; the `secrets` service generates it when empty.
VOXI_WORKER_API_KEY=
# TLS for the proxy (infra/compose.proxy.yaml). A loopback self-signed certificate
# is generated once into certs/ when neither voxi.crt nor voxi.key exists. Set
# REQUIRE_PROVIDED_CERTS=1 for LAN/production: then nothing is ever generated and
# a missing pair refuses to start (fail closed).
REQUIRE_PROVIDED_CERTS=
# Extra subjectAltName entries for a GENERATED certificate, comma separated. Bare
# names become DNS: entries, a bare IPv4 address becomes IP:; any entry that already
# contains ":" is used as-is. localhost/127.0.0.1/::1 and the LAN bind address are
# always included.
# VOXI_TLS_SAN=voxi.lan,192.168.1.50,IP:10.0.0.7
VOXI_TLS_SAN=
VOXI_PORT=8080
# Host interface the published gateway port binds to. Keep 127.0.0.1 unless another
# device on your LAN must reach it. For a same-LAN OpenWebUI, set this to this PC's LAN
# IP (e.g. 192.168.1.50) and point OpenWebUI at http://<that-ip>:8080/v1. Never use a
# public/WAN address; restrict Windows firewall inbound to your subnet and keep VOXI_API_KEY strong.
VOXI_BIND_IP=127.0.0.1
VOXI_CPU_THREADS=4
VOXI_REQUEST_TIMEOUT=120
VOXI_MAX_UPLOAD_BYTES=26214400
VOXI_MAX_AUDIO_SECONDS=600
VOXI_MAX_CONCURRENCY=4
VOXI_RATE_LIMIT_PER_MINUTE=60
VOXI_ALLOW_ALLOY=false

# Streaming transports (WebSocket). Session stream sample rate: 8000 or 16000.
VOXI_STREAM_SAMPLE_RATE=16000
# Synthesis chunk length in ms on the wire: 20/40/60/100/120/200 (client may override per request).
VOXI_TTS_CHUNK_MS=100
# Close a socket after this many seconds without any inbound frame.
VOXI_WS_IDLE_TIMEOUT=60
# Per-utterance STT allowance for streaming/session transcription.
VOXI_STREAM_STT_TIMEOUT=30
# Energy VAD turn detection: sustained loud run before speech starts, trailing silence before
# an endpoint, minimum loud time before a start is accepted (false-start suppression).
VOXI_VAD_START_MS=100
VOXI_VAD_END_MS=700
VOXI_VAD_MIN_SPEECH_MS=200
# RMS hysteresis on 16-bit samples. Quiet telephony/mic streams may need a lower open level;
# always measure against real recordings instead of copying these defaults blindly.
VOXI_VAD_OPEN_RMS=350
VOXI_VAD_CLOSE_RMS=200

# Optional Antalia: the model installs automatically on `up -d`; add --profile antalia to run the
# worker, then set this URL.
ANTALIA_URL=
# ANTALIA_URL=http://tts-antalia:8083

# Optional whisper-large-v3-turbo: the model installs automatically on `up -d` (about 1.6 GB); add
# --profile stt-turbo to run the worker, then set this URL.
# Both STT models then serve at once (whisper-small stays the default alias target); leave empty
# and `whisper-large-v3-turbo` is not advertised and not routable.
STT_TURBO_URL=
# STT_TURBO_URL=http://stt-whisper-turbo:8084

# Optional existing n8n deployment. Not needed for file STT/TTS.
# Fixed production webhook URL, no query/credentials/fragment; resolve from gateway container.
VOXI_N8N_WEBHOOK_URL=
# Separate secret; Header Auth credential value must be "Bearer <this-key>".
VOXI_N8N_API_KEY=
VOXI_N8N_TIMEOUT=10
# No phone transfer implementation in M1; leave empty.
VOXI_TRANSFER_TARGETS=
VOXI_FALLBACK_TEXT="Şu anda hizmet veremiyorum. Lütfen daha sonra tekrar deneyin."

# ---------------------------------------------------------------------------
# Turnkey TLS proxy (infra/compose.proxy.yaml). Run bootstrap.ps1 instead of
# editing these by hand: it generates the keys below, registers the local WebUI
# key in VOXI_API_KEYS_JSON and sets owner-only permissions on .env.
# ---------------------------------------------------------------------------
# Public host interface + port for the nginx proxy. Default is loopback only, so
# the keyless local identity (VOXI_PROXY_INJECT) is sound (same-host). The proxy
# entrypoint REFUSES to start if injection is true while this is not loopback.
VOXI_PROXY_BIND_IP=127.0.0.1
VOXI_PROXY_PORT=8443
# When true the proxy injects VOXI_WEBUI_KEY for same-origin /v1 calls and
# enforces the Host-allowlist + cross-site guards (loopback keyless identity).
# Set false to expose the console over the LAN: no injection, guards off, every
# client must send its own key over TLS (bootstrap.ps1 -ExposeLan flips this).
VOXI_PROXY_INJECT=true
# The two below are consumed ONLY by the stack-merge example overlay
# infra/compose.lan-stack.example.yaml (docs/deployment.md §"Merging into an existing
# Compose stack"). Leave empty for the standalone deployment of this repository; a
# consuming stack sets them in ITS OWN copy of this file. VOXI_MODELS_DIR is shared
# by workers AND the four provision-* downloaders; the model containers run as UID
# 10001, so the host tree needs matching ownership before first `up`.
VOXI_MODELS_DIR=
# Name of an existing Docker network to join (external: true), so containers of the
# consuming stack reach the fixed container names (voxi-gateway, ...) or the service
# alias `gateway` by DNS.
VOXI_JOIN_NETWORK=
# Trusted-LAN injection, explicit opt-in (integrations/nginx/README.md): with
# VOXI_PROXY_INJECT=true and a non-loopback VOXI_PROXY_BIND_IP, the entrypoint
# refuses to start UNLESS this is also true. Then injection stays on and the
# Host/origin guards accept the RFC1918 private ranges plus the extra hosts
# below — every device on that network can use the gateway WITHOUT a key, so
# only enable it on a network you fully trust (TLS stays mandatory in all modes).
VOXI_ALLOW_LAN_INJECT=
# Extra plain host names/IPs (comma separated, letters/digits/dots/hyphens only)
# treated as same-site in trusted-LAN injection mode, e.g. the server's own LAN
# address or its docker alias: 10.0.0.231,nas.lan. Ignored when the flag above
# is not true; a value that could break out of the nginx map syntax refuses start.
VOXI_PROXY_EXTRA_HOSTS=
# Separate, revocable key for the local WebUI only (NEVER the master VOXI_API_KEY).
# bootstrap.ps1 generates it and stores its SHA-256 in VOXI_API_KEYS_JSON as id
# "webui-local". To revoke, drop that record and regenerate. Leave empty and let
# bootstrap.ps1 fill it; the proxy will not start in inject mode if it is unset.
VOXI_WEBUI_KEY=
